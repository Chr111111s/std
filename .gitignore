# Dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/

# Build output and tool caches
dist/
dist-ssr/
.vite/
.vite-temp/
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# Logs and diagnostic reports
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.*.json

# Local configuration and environment variables
*.local
.env
.env.*
!.env.example

# Local Vercel project data (keep vercel.json tracked)
.vercel/

# Shared PowerShell scripts belong in Git; use this suffix for personal scripts
*.local.ps1

# Editor settings (keep shared VS Code configuration)
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
.idea/
.vs/
*.suo
*.user
*.swp
*.swo
*~

# Operating-system files
.DS_Store
._*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Temporary files
*.tmp
*.temp
/tmp/
/temp/

# Local source audio; the published copy is public/audio/musica.mp3
/resources/musica.mpeg

# Keep resources/, public/photos/ and src/data/photos.generated.json tracked:
# photo preparation is manual and does not run during the production build.
